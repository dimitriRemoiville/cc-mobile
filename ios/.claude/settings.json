{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(xcodebuild *)",
      "Bash(xcrun *)",
      "Bash(swift *)",
      "Bash(swift build*)",
      "Bash(swift test*)",
      "Bash(swift package *)",
      "Bash(swiftformat *)",
      "Bash(swiftlint *)",
      "Bash(pod *)",
      "Bash(fastlane *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git restore*)",
      "Bash(git stash*)",
      "Bash(ls*)",
      "Bash(find*)",
      "Bash(tree*)",
      "Bash(wc*)",
      "Bash(rm -rf .build/*)",
      "Bash(rm -rf DerivedData/*)",
      "Bash(rm -rf Pods/*)",
      "Bash(rm -rf Podfile.lock)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf /*)"
    ]
  }
}
